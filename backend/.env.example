# Copy to .env and adjust. NEVER commit .env — it is gitignored.
# The backend reads every one of these through application.yml; nothing is hard-coded.

SERVER_PORT=8000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nibash
MYSQL_USER=nibash
MYSQL_PASSWORD=nibash_dev_password

# Where uploads land until Azure Blob Storage is wired up (Week 6)
NIBASH_MEDIA_DIR=./media

# Vite dev server origins allowed through CORS (production uses Nginx, single origin)
NIBASH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# SMTP for the Week 5 invoice-reminder job. Left blank, mail simply no-ops.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
