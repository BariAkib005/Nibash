# Settings for `docker compose` (docker-compose.yml). Copy to .env and fill in — .env is gitignored.
# (For running the backend directly with ./mvnw, use backend/.env.example instead.)

# Port the site is served on: http://localhost:8080
HTTP_PORT=8080
# The address people use to reach the site — CORS for any non-proxied caller, and the base of the
# links in invitation and rental emails.
PUBLIC_ORIGIN=http://localhost:8080

# MySQL. Use long random values anywhere but a laptop.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=nibash
MYSQL_USER=nibash
MYSQL_PASSWORD=change-me-app

# true for ONE start to load the demo fixture (idempotent), then back to false.
NIBASH_SEED=false
# The 00:05 overdue sweep and 08:00 invoice reminders (Asia/Dhaka).
NIBASH_JOBS_ENABLED=true
# If set, intercom hardware must send it as X-Intercom-Secret.
NIBASH_INTERCOM_WEBHOOK_SECRET=

# Outbound email for reminders, invitations and rental replies. Left as-is, mail quietly no-ops
# (invitation links are still shown on screen to share by hand).
NIBASH_MAIL_FROM=no-reply@nibash.bd
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
